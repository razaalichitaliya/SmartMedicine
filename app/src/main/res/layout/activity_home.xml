<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background"
    android:overScrollMode="never"
    android:scrollbars="none">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_header"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="48dp"
            android:paddingBottom="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextHeroSub" />
                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextHeader" />
                </LinearLayout>
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp">
                    <ImageButton
                        android:id="@+id/btnNotifications"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_circle"
                        android:src="@drawable/ic_notifications"
                        android:tint="@color/white"
                        android:contentDescription="@string/cd_notifications" />
                    <View
                        android:id="@+id/viewBellDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="9dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_dot_amber"
                        android:visibility="gone" />
                </FrameLayout>
                <TextView
                    android:id="@+id/btnProfile"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:background="@drawable/bg_circle_white"
                    android:textColor="@color/primary_dark"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/cd_profile" />
            </LinearLayout>
            <FrameLayout
                android:id="@+id/cardMedicine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel_dark"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="24dp">
                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_pill"
                    android:tint="@color/white"
                    android:alpha="0.09"
                    android:contentDescription="@null" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/TextHeroSub"
                            android:text="@string/next_dose" />
                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />
                        <TextView
                            android:id="@+id/tvNextIn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/TextAmber" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvNextTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextDisplay"
                        android:layout_marginTop="6dp" />
                    <TextView
                        android:id="@+id/tvNextName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextHeader"
                        android:layout_marginTop="4dp" />
                    <TextView
                        android:id="@+id/tvNextSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextHeroSub"
                        android:layout_marginTop="2dp" />
                    <LinearLayout
                        android:id="@+id/rowDoseActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="20dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTakeNow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            style="@style/AppButtonLight"
                            android:text="@string/btn_mark_taken"
                            android:layout_weight="1.3" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSnooze"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            style="@style/AppButtonOnDark"
                            android:text="@string/btn_snooze"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextH2"
                android:text="@string/quick_actions"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:id="@+id/btnAddMedicine"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_mint"
                        android:padding="16dp"
                        android:src="@drawable/ic_add"
                        android:tint="@color/primary"
                        android:contentDescription="@null" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextCaption"
                        android:text="@string/qa_add"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btnPrescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_blue"
                        android:padding="16dp"
                        android:src="@drawable/ic_description"
                        android:tint="@color/blue"
                        android:contentDescription="@null" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextCaption"
                        android:text="@string/qa_prescriptions"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btnHistory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_violet"
                        android:padding="16dp"
                        android:src="@drawable/ic_history"
                        android:tint="@color/violet"
                        android:contentDescription="@null" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextCaption"
                        android:text="@string/qa_history"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btnRefill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_amber"
                        android:padding="16dp"
                        android:src="@drawable/ic_refresh"
                        android:tint="@color/amber_icon"
                        android:contentDescription="@null" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextCaption"
                        android:text="@string/qa_refills"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="28dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/TextH2"
                    android:text="@string/todays_progress"
                    android:layout_weight="1" />
                <TextView
                    android:id="@+id/tvDosesTaken"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextCaption" />
            </LinearLayout>
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressToday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:progress="0"
                app:trackThickness="8dp"
                app:trackCornerRadius="4dp"
                app:indicatorColor="@color/primary"
                app:trackColor="@color/primary_light" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/TextH2"
                    android:text="@string/todays_schedule"
                    android:layout_weight="1" />
                <TextView
                    android:id="@+id/tvToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextCaption" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />
            <TextView
                android:id="@+id/tvScheduleEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextCaption"
                android:text="@string/empty_schedule"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRefill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/amber_soft"
                app:strokeColor="@color/amber_stroke"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="8dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_tile_amber"
                        android:padding="11dp"
                        android:src="@drawable/ic_warning"
                        android:tint="@color/amber_icon"
                        android:contentDescription="@null" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:id="@+id/tvRefillTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/TextBodyStrong" />
                        <TextView
                            android:id="@+id/tvRefillSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/TextCaption"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/text_secondary"
                        android:contentDescription="@null" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

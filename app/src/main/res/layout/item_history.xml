<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">
        <ImageView
            android:id="@+id/ivHistIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_tile_mint"
            android:padding="11dp"
            android:src="@drawable/ic_check_circle"
            android:tint="@color/primary"
            android:contentDescription="@null" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginStart="14dp">
            <TextView
                android:id="@+id/tvHistName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextBodyStrong" />
            <TextView
                android:id="@+id/tvHistSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextCaption"
                android:layout_marginTop="2dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/tvHistStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_gray"
            android:textColor="@color/status_gray_text"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline" />
</LinearLayout>
